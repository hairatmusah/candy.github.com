<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Product Details | Ayisha Cosmetics</title>

    <link rel="stylesheet" href="style.css">

</head>

<body>

    <!-- HEADER -->

    <header class="header">

        <div class="logo">
            AYISHA <span>COSMETICS</span>
        </div>

        <nav>
            <a href="index.html">Home</a>
            <a href="index.html#products">Shop</a>
            <a href="index.html#categories">Categories</a>
        </nav>

        <button
            class="cart-button"
            onclick="openCart()">

            🛒 Cart

            <span id="cart-count">
                0
            </span>

        </button>

    </header>


    <!-- PRODUCT DETAILS -->

    <main class="product-details-page">

        <a
            href="index.html"
            class="back-button">

            ← Back to Shop

        </a>


        <div
            id="product-details"
            class="product-details">

        </div>

    </main>


    <!-- CART -->

    <div id="cart" class="cart">

        <div class="cart-header">

            <h2>Your Cart</h2>

            <button onclick="closeCart()">
                ✕
            </button>

        </div>

        <div id="cart-items"></div>

        <div class="cart-total">

            <span>Total:</span>

            <strong id="cart-total">
                GH₵ 0
            </strong>

        </div>

        <a
            href="checkout.html"
            class="checkout-btn">

            Proceed to Checkout

        </a>

    </div>


    <script src="script.js"></script>


    <script>

        /* PRODUCT DATABASE */

        const products = {

            "lip-gloss": {

                name: "Luxury Lip Gloss",

                category: "MAKEUP",

                price: 35,

                rating: "★★★★★",

                image:
                "https://images.unsplash.com/photo-1586495777744-4413f21062fa?auto=format&fit=crop&w=800&q=80",

                description:
                "A beautiful glossy lip product designed to give your lips a smooth and shiny finish. Perfect for everyday looks and special occasions.",

                details: [
                    "Smooth glossy finish",
                    "Easy to apply",
                    "Perfect for everyday use",
                    "Stylish and convenient"
                ]

            },


            "perfume": {

                name: "Elegant Perfume",

                category: "FRAGRANCE",

                price: 100,

                rating: "★★★★★",

                image:
                "https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=800&q=80",

                description:
                "An elegant fragrance with a beautiful scent suitable for everyday wear and special occasions.",

                details: [
                    "Elegant fragrance",
                    "Perfect for special occasions",
                    "Easy to carry",
                    "Beautiful presentation"
                ]

            },


            "body-lotion": {

                name: "Luxury Body Lotion",

                category: "BODY CARE",

                price: 70,

                rating: "★★★★☆",

                image:
                "https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=800&q=80",

                description:
                "A nourishing body lotion for your everyday body-care routine.",

                details: [
                    "Smooth texture",
                    "Easy to apply",
                    "Suitable for daily routines",
                    "Fresh feeling"
                ]

            },


            "hair-oil": {

                name: "Hair Care Oil",

                category: "HAIR CARE",

                price: 45,

                rating: "★★★★★",

                image:
                "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=800&q=80",

                description:
                "A hair-care product designed to complement your everyday hair routine.",

                details: [
                    "Easy to use",
                    "Suitable for hair-care routines",
                    "Convenient packaging",
                    "Great everyday product"
                ]

            },


            "body-spray": {

                name: "Luxury Body Spray",

                category: "FRAGRANCE",

                price: 60,

                rating: "★★★★★",

                image:
                "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80",

                description:
                "A fresh body spray with a pleasant fragrance for everyday use.",

                details: [
                    "Fresh fragrance",
                    "Easy to carry",
                    "Great for everyday use",
                    "Beautiful presentation"
                ]

            },


            "slippers": {

                name: "Elegant Ladies Slippers",

                category: "FASHION",

                price: 80,

                rating: "★★★★☆",

                image:
                "https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=800&q=80",

                description:
                "Stylish ladies slippers designed for comfort and everyday fashion.",

                details: [
                    "Stylish design",
                    "Comfortable",
                    "Suitable for everyday wear",
                    "Fashionable look"
                ]

            }

        };


        /* GET PRODUCT FROM URL */

        const params =
            new URLSearchParams(
                window.location.search
            );

        const productName =
            params.get("product");


        const product =
            products[productName];


        const container =
            document.getElementById(
                "product-details"
            );


        /* DISPLAY PRODUCT */

        if (product) {

            container.innerHTML = `

                <div class="details-image">

                    <img
                        src="${product.image}"
                        alt="${product.name}"
                    >

                </div>


                <div class="details-info">

                    <p class="category">
                        ${product.category}
                    </p>

                    <h1>
                        ${product.name}
                    </h1>

                    <div class="rating">
                        ${product.rating}
                    </div>

                    <h2 class="details-price">
                        GH₵ ${product.price}
                    </h2>

                    <p class="details-description">
                        ${product.description}
                    </p>

                    <h3>
                        Product Details
                    </h3>

                    <ul>

                        ${product.details
                            .map(
                                detail =>
                                `<li>${detail}</li>`
                            )
                            .join("")
                        }

                    </ul>


                    <button
                        class="add-details-cart"
                        onclick="addToCart(
                            '${product.name}',
                            ${product.price},
                            '${product.image}'
                        )">

                        Add to Cart 🛒

                    </button>

                </div>

            `;

        } else {

            container.innerHTML = `

                <h2>
                    Product not found
                </h2>

                <a href="index.html">
                    Return to shop
                </a>

            `;

        }

    </script>

</body>

</html>

Then add this to the bottom of style.css

/* PRODUCT DETAILS PAGE */

.product-details-page {
    padding: 60px 7%;
    min-height: 80vh;
}

.back-button {
    display: inline-block;
    margin-bottom: 30px;
    color: #b01860;
    text-decoration: none;
    font-weight: bold;
}

.product-details {
    max-width: 1000px;
    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 50px;

    align-items: center;
}

.details-image img {
    width: 100%;
    max-height: 550px;
    object-fit: cover;
    border-radius: 20px;
}

.details-info h1 {
    font-size: 45px;
    margin: 10px 0;
}

.details-price {
    color: #b01860;
    margin: 20px 0;
}

.details-description {
    color: #666;
    line-height: 1.8;
    margin-bottom: 25px;
}

.details-info ul {
    padding-left: 20px;
    margin: 15px 0 30px;
}

.details-info li {
    margin-bottom: 10px;
    color: #555;
}

.add-details-cart {
    background: #b01860;
    color: white;
    border: none;

    padding: 16px 30px;

    border-radius: 30px;

    cursor: pointer;

    font-weight: bold;
    font-size: 16px;
}

.add-details-cart:hover {
    background: #861349;
}


/* MOBILE PRODUCT PAGE */

@media(max-width: 700px) {

    .product-details {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .details-info h1 {
        font-size: 32px;
    }

}
