
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Checkout | Ayisha Cosmetics</title>

    <link rel="stylesheet" href="style.css">

</head>


<body>


<!-- HEADER -->

<header class="header">

    <div class="logo">
        AYISHA <span>COSMETICS</span>
    </div>

    <a href="index.html">
        ← Continue Shopping
    </a>

</header>



<!-- CHECKOUT -->

<section class="checkout-page">

    <div class="checkout-title">

        <p class="small-title">
            AYISHA COSMETICS
        </p>

        <h1>
            Checkout
        </h1>

        <p>
            Complete your order below.
        </p>

    </div>



    <div class="checkout-container">


        <!-- CUSTOMER FORM -->

        <div class="customer-details">

            <h2>
                Customer Information
            </h2>


            <form id="checkout-form">


                <label>
                    Full Name
                </label>

                <input
                    type="text"
                    id="customer-name"
                    placeholder="Your full name"
                    required
                >



                <label>
                    Phone Number
                </label>

                <input
                    type="tel"
                    id="customer-phone"
                    placeholder="024 000 0000"
                    required
                >



                <label>
                    Delivery Location
                </label>

                <input
                    type="text"
                    id="customer-location"
                    placeholder="Example: Accra, Madina"
                    required
                >



                <label>
                    Delivery Option
                </label>

                <select
                    id="delivery-option"
                    required
                >

                    <option value="">
                        Choose delivery
                    </option>

                    <option value="Standard Delivery">
                        Standard Delivery
                    </option>

                    <option value="Pickup">
                        Pickup
                    </option>

                </select>



                <label>
                    Payment Method
                </label>

                <select
                    id="payment-method"
                    required
                >

                    <option value="">
                        Choose payment method
                    </option>

                    <option value="Cash on Delivery">
                        Cash on Delivery
                    </option>

                    <option value="Mobile Money">
                        Mobile Money
                    </option>

                </select>



                <label>
                    Order Note
                </label>

                <textarea
                    id="customer-message"
                    placeholder="Any additional information?"
                ></textarea>



                <button
                    type="submit"
                    class="place-order-btn"
                >

                    Place Order on WhatsApp

                </button>


            </form>

        </div>



        <!-- ORDER SUMMARY -->

        <div class="order-summary">

            <h2>
                Your Order
            </h2>


            <div id="checkout-items">

            </div>


            <div class="checkout-total">

                <span>
                    Total
                </span>

                <strong id="checkout-total">
                    GH₵ 0
                </strong>

            </div>

        </div>


    </div>

</section>



<!-- FOOTER -->

<footer>

    <div class="footer-logo">
        AYISHA COSMETICS
    </div>

    <p>
        Beauty • Style • Confidence
    </p>

    <p>
        © 2026 Ayisha Cosmetics
    </p>

</footer>



<script>


// GET CART

let cart =
    JSON.parse(
        localStorage.getItem(
            "ayishaCart"
        )
    ) || [];


// ELEMENTS

const checkoutItems =
    document.getElementById(
        "checkout-items"
    );

const checkoutTotal =
    document.getElementById(
        "checkout-total"
    );


// TOTAL

let total = 0;


// EMPTY CART

if (cart.length === 0) {

    checkoutItems.innerHTML = `

        <div class="empty-cart">

            <div class="empty-cart-icon">
                🛒
            </div>

            <h3>
                Your cart is empty
            </h3>

            <p>
                Add products before checking out.
            </p>

            <a
                href="index.html#products"
                class="shop-btn"
            >
                Shop Now
            </a>

        </div>

    `;

}


// DISPLAY PRODUCTS

cart.forEach(item => {

    total +=
        item.price *
        item.quantity;


    checkoutItems.innerHTML += `

        <div class="checkout-item">

            <img
                src="${item.image}"
                alt="${item.name}"
            >


            <div>

                <strong>
                    ${item.name}
                </strong>

                <p>
                    ${item.quantity}
                    × GH₵ ${item.price}
                </p>

            </div>

        </div>

    `;

});


// TOTAL

checkoutTotal.textContent =
    "GH₵ " +
    total.toFixed(2);



// PLACE ORDER

document
.getElementById("checkout-form")
.addEventListener(
    "submit",
    function(event) {

        event.preventDefault();


        // CUSTOMER DETAILS

        const name =
            document.getElementById(
                "customer-name"
            ).value;

        const phone =
            document.getElementById(
                "customer-phone"
            ).value;

        const location =
            document.getElementById(
                "customer-location"
            ).value;

        const delivery =
            document.getElementById(
                "delivery-option"
            ).value;

        const payment =
            document.getElementById(
                "payment-method"
            ).value;

        const note =
            document.getElementById(
                "customer-message"
            ).value;



        // CREATE WHATSAPP MESSAGE

        let message =
            "Hello Ayisha Cosmetics!%0A%0A";


        message +=
            "*NEW ORDER*%0A%0A";


        message +=
            "*Customer:* " +
            name +
            "%0A";


        message +=
            "*Phone:* " +
            phone +
            "%0A";


        message +=
            "*Location:* " +
            location +
            "%0A";


        message +=
            "*Delivery:* " +
            delivery +
            "%0A";


        message +=
            "*Payment:* " +
            payment +
            "%0A%0A";


        message +=
            "*ORDER DETAILS*%0A";


        cart.forEach(item => {

            message +=
                item.name +
                " × " +
                item.quantity +
                " = GH₵ " +
                (
                    item.price *
                    item.quantity
                ) +
                "%0A";

        });


        message +=
            "%0A*TOTAL: GH₵ " +
            total.toFixed(2) +
            "*%0A";


        if (note) {

            message +=
                "%0A*Note:* " +
                note;

        }



        // YOUR WHATSAPP NUMBER

        const whatsappNumber =
            "0278596913";


        const whatsappURL =
            "https://wa.me/" +
            whatsappNumber +
            "?text=" +
            message;


        // OPEN WHATSAPP

        window.open(
            whatsappURL,
            "_blank"
        );


        // CLEAR CART

        localStorage.removeItem(
            "ayishaCart"
        );

    }
);

</script>



<style>


/* CHECKOUT */

.checkout-page {
    padding: 70px 7%;
    min-height: 80vh;
}

.checkout-title {
    text-align: center;
    margin-bottom: 45px;
}

.checkout-title h1 {
    font-size: 48px;
    color: #b01860;
    margin-bottom: 10px;
}

.checkout-title p {
    color: #777;
}


.checkout-container {

    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 30px;

}


.customer-details,
.order-summary {

    background: white;

    padding: 30px;

    border-radius: 18px;

    box-shadow:
        0 8px 30px
        rgba(80,20,50,0.08);

}


.customer-details h2,
.order-summary h2 {

    margin-bottom: 25px;

    font-size: 25px;

}


.customer-details label {

    display: block;

    margin-top: 17px;

    margin-bottom: 7px;

    font-weight: bold;

    font-size: 14px;

}


.customer-details input,
.customer-details select,
.customer-details textarea {

    width: 100%;

    padding: 14px;

    border: 1px solid #ddd;

    border-radius: 9px;

    outline: none;

    font-size: 14px;

    background: white;

}


.customer-details textarea {

    height: 100px;

    resize: none;

}


.customer-details input:focus,
.customer-details select:focus,
.customer-details textarea:focus {

    border-color: #b01860;

}


.place-order-btn {

    width: 100%;

    border: none;

    margin-top: 25px;

    padding: 16px;

    border-radius: 30px;

    background: #25D366;

    color: white;

    font-weight: bold;

    cursor: pointer;

    font-size: 15px;

}


.place-order-btn:hover {

    background: #1da851;

}


.checkout-item {

    display: flex;

    gap: 15px;

    padding: 15px 0;

    border-bottom: 1px solid #eee;

}


.checkout-item img {

    width: 70px;

    height: 70px;

    object-fit: cover;

    border-radius: 10px;

}


.checkout-item strong {

    display: block;

    margin-bottom: 8px;

}


.checkout-item p {

    color: #777;

}


.checkout-total {

    display: flex;

    justify-content: space-between;

    margin-top: 25px;

    padding-top: 20px;

    border-top: 2px solid #eee;

    font-size: 21px;

}


.checkout-total strong {

    color: #b01860;

}


@media(max-width: 700px) {

    .checkout-container {

        grid-template-columns: 1fr;

    }

    .checkout-title h1 {

        font-size: 38px;

    }

}

</style>


</body>

</html>

